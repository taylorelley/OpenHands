# =============================================================================
# OpenHands — offline / air-gapped environment example configuration
# =============================================================================
# Copy to `.env` (or export these in your shell / compose env) and adjust for
# your environment. See docs/deployment/offline.md for the full guide.
#
# This file targets an isolated environment with:
#   * a self-hosted GitLab container + package (pip/npm/apt) registry,
#   * an aggressive SSL-inspection proxy (custom corporate root CA), and
#   * a self-hosted, OpenAI-compatible LLM endpoint.
# -----------------------------------------------------------------------------

# --- Runtime agent-server (sandbox) image -----------------------------------
# Mirror ghcr.io/openhands/agent-server:1.29.0-python into your GitLab registry,
# then point OpenHands at it. Pulled at runtime by the Docker sandbox service.
AGENT_SERVER_IMAGE_REPOSITORY=registry.gitlab.local/openhands/agent-server
AGENT_SERVER_IMAGE_TAG=1.29.0-python

# --- SSL inspection ----------------------------------------------------------
# Preferred: install the corporate root CA and keep verification ON.
# At runtime, the app image bakes any certs from containers/certs/ into
# /etc/ssl/certs/ca-certificates.crt (already the image default). To point at a
# different in-container bundle, set:
# OPENHANDS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
#
# Escape hatch (NOT recommended): disable TLS verification entirely.
# OPENHANDS_DISABLE_SSL_VERIFY=true

# --- Self-hosted LLM (OpenAI-compatible) -------------------------------------
# Configure the LLM in the UI/settings with:
#   model    = openai/<served-model-name>
#   base_url = https://llm.internal.local/v1
#   api_key  = <your key>
# LLM_* vars are auto-forwarded into the agent-server sandbox.
# If you front the model with a LiteLLM proxy, override the default proxy URL:
# LITE_LLM_API_URL=https://llm-proxy.internal.local

# =============================================================================
# Build-time configuration
# =============================================================================
# docker-compose.yml forwards the variables below to the image build, so you can
# set them here (or in your shell) and just run `docker compose up -d --build`.
#
# Base image mirrors:
# NODE_IMAGE=registry.gitlab.local/mirror/node:25.9-trixie-slim
# PYTHON_IMAGE=registry.gitlab.local/mirror/python:3.13.7-slim-trixie
#
# Package mirrors:
# PIP_INDEX_URL=https://gitlab.local/api/v4/projects/1/packages/pypi/simple
# PIP_TRUSTED_HOST=gitlab.local
# NPM_CONFIG_REGISTRY=https://gitlab.local/api/v4/projects/1/packages/npm/
#
# Custom CA (preferred, secure): drop your *.crt into containers/certs/ before
# building; it is baked into the trust store automatically (no variable needed).
#
# Insecure bypass (last resort): build WITHOUT a CA by disabling TLS verification
# for pip / poetry / npm during the build. Insecure - prefer the CA above.
# INSECURE_SKIP_TLS_VERIFY=1
#
# Flaky/slow proxy resilience: if `poetry install` fails partway through with
# connection errors ("server is not responding" / "hostname cannot be resolved")
# while reaching public PyPI through the proxy, reduce poetry's download
# parallelism and raise its timeout. NOTE: poetry does NOT use PIP_INDEX_URL, so a
# GitLab PyPI registry that only hosts your *published* packages cannot serve the
# full dependency tree - these knobs keep the build on public PyPI but make it
# survive a choking proxy. (pip already uses a 60s timeout / 5 retries here.)
# POETRY_INSTALLER_MAX_WORKERS=2
# POETRY_REQUESTS_TIMEOUT=60
#
# Note: OPENHANDS_DISABLE_SSL_VERIFY (above) is a RUNTIME flag for the app process
# and has NO effect on the image build; use INSECURE_SKIP_TLS_VERIFY for the build.
#
# The dev image (containers/dev/Dockerfile) additionally accepts, via --build-arg:
#   BASE_IMAGE=registry.gitlab.local/mirror/ubuntu:26.04
#   APT_MIRROR=https://gitlab.local/repository/apt
